# Benchmark data + raw outputs are NOT committed (size + licenses); every
# dataset gets a download_<name>.py + checksum so a fresh clone rebuilds
# data/ deterministically. EXCEPTIONS that ARE committed: scorecards/ (small
# JSONs), the abstention ground-truth JSON, and the AgentRetriever frozen
# variant set (see RETRIEVAL-EVAL-SPEC Phase 2 / KICKOFF-QUESTIONS Q3).
data/
results/
# Track B live-capture artifacts (answers + retrieved contexts). Bulky
# (~2MB/arm) and regenerable from the live chat; the derived scorecard under
# scorecards/ is the committed record.
faithfulness_runs/
c1_runs/
c2_runs/
