# Qwen3.6-35B-A3B, the production backbone from the 2026-07 encoder cutover
# until 2026-08-26. Kept for the record: the 07-27 Track C/D numbers were
# produced on it. MoE 35B total / 3B active, 10 KV-bearing layers x 2 KV
# heads, AWQ 4-bit g32, vision tower at BF16. No reasoning_effort dial.
MODEL_SLUG=qwen3.6-35b-a3b
MODEL_ID=cyankiwi/Qwen3.6-35B-A3B-AWQ-4bit
MODEL_DIR=qwen3.6-35b-a3b-awq-4bit
MODEL_NAME=qwen3.6-35b-a3b
MODEL_DESC="Qwen3.6-35B-A3B (MoE 35B / 3B active, AWQ-4bit g32, 64k ctx, vision)"
HF_EXCLUDE=
VLLM_QUANTIZATION=compressed-tensors
VLLM_KV_CACHE_DTYPE=fp8
VLLM_TOOL_PARSER=qwen3_xml
VLLM_REASONING_PARSER=qwen3
VLLM_EXTRA_ARGS="--dtype float16"
VLLM_GPU_MEM_UTIL=0.90
VLLM_MAX_MODEL_LEN=65536
# 310,827 KV tokens on one card = 4.74x at 64k (measured, job 923).
VLLM_MAX_NUM_SEQS_SINGLE=2
VLLM_MAX_NUM_SEQS_TP2=8
LLM_THINKING_MODE=enable_thinking
# The 3.6 chat template has no effort kwarg; the 07-27 runs sent none.
LLM_REASONING_EFFORT=
KV_KIB_PER_TOKEN=10
SAMPLING_DEFAULT='{"temperature": 1.0, "top_p": 0.95, "top_k": 20, "min_p": 0.0, "presence_penalty": 1.5}'
SAMPLING_CODE='{"temperature": 0.6, "top_p": 0.95, "top_k": 20, "min_p": 0.0, "presence_penalty": 0.0}'
