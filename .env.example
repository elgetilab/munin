# ==============================================================================
# MUNIN - single-host configuration
# ==============================================================================
# Copy to `.env` at the repo root and edit. Compose reads `.env` from the
# directory you run it in, so this file applies when you run `docker compose`
# HERE, at the repo root.
#
#     cp .env.example .env
#     docker compose up
#
# It does NOT affect the reference cluster: `deploy.sh` runs compose from
# /opt/munin/docker, which has its own .env (a symlink to cluster.env). The
# compose file's built-in defaults are the production values, so the cluster
# needs no overrides at all.
#
# See docs/SINGLE-HOST-PLAN.md for the full picture.
#
# ------------------------------------------------------------------------------
# RELATIVE PATHS: read this once and the rest makes sense
# ------------------------------------------------------------------------------
# Compose resolves a relative path from a variable against the PROJECT
# DIRECTORY, which is the directory of the first file in COMPOSE_FILE, i.e.
# `backend/docker/`. It is NOT relative to this file or to your shell.
#
#   ../..      = the repo root
#   ..         = backend/
#   .          = backend/docker/
#
# That is why the paths below look like they have one `..` too many. They do
# not. Use absolute paths instead if you prefer; nothing here requires
# relative ones.
# ==============================================================================


# ------------------------------------------------------------------------------
# Which services to run
# ------------------------------------------------------------------------------
# Both halves of the stack, in one `docker compose up` from the repo root.
COMPOSE_FILE=backend/docker/docker-compose.yml

# Feature profiles.
#   rag         retrieval service + sandbox. Required; nothing works without it.
#   pipeline    paper ingest watcher, corpus detect sweep, nightly
#               re-attribution and the nightly embedding map. Needed if you
#               want to add your own PDFs.
#   monitoring  Prometheus. Pure overhead for a demo; drop it on a small box.
#   gpu         a local vLLM server. NOT included below on purpose: it needs an
#               NVIDIA GPU and runtime, and fails to start without one. Add it
#               only if you have the hardware, and then set
#               LLM_BASE_URL=http://vllm:8000 above.
#
# NOTE: `pipeline` replaces four systemd units. Do not enable it on a host that
# already runs those units, or two watchers will ingest the same directory.
COMPOSE_PROFILES=rag,pipeline,monitoring


# ------------------------------------------------------------------------------
# Instance isolation
# ------------------------------------------------------------------------------
# Prefix for container names, image tags and docker networks. Change it if this
# host already runs a Munin instance (the reference cluster uses `munin`), or if
# you want two instances side by side.
MUNIN_PREFIX=munin

# Host ports. Every service binds to 127.0.0.1 only. Change any that clash with
# something you already run; 7474 and 8080 are the usual offenders.
QDRANT_HOST_PORT=6333
QDRANT_GRPC_HOST_PORT=6334
NEO4J_HTTP_HOST_PORT=7474
NEO4J_BOLT_HOST_PORT=7687
GROBID_HOST_PORT=8070
SEARXNG_HOST_PORT=8888
RETRIEVAL_HOST_PORT=8080
PROMETHEUS_HOST_PORT=9090


# ------------------------------------------------------------------------------
# Where runtime state lives
# ------------------------------------------------------------------------------
# Everything mutable (vector DB, graph DB, chat SQLite, uploaded PDFs, model
# weights, caches) goes under one directory. Created on first `up`.
# `../../.runtime` = <repo>/.runtime  (see the relative-path note above).
MUNIN_ROOT=../../.runtime

# Build contexts and read-only config, pointed back at the working tree so a
# clone builds its own images instead of expecting a prior deploy into /opt.
MUNIN_RETRIEVAL_SRC=../retrieval
MUNIN_SANDBOX_SRC=../sandbox
MUNIN_PIPELINE_SRC=../scripts/pipeline
# Scripts root, mounted into the `pipeline` profile's containers. Holds both
# pipeline/ and knowledge/ plus the run-daily.sh scheduler.
MUNIN_SCRIPTS_SRC=../scripts
MUNIN_KNOWLEDGE_SRC=../scripts/knowledge
MUNIN_PERSONAS_SRC=../../shared/personas
MUNIN_AGENT_CONFIG=../config
MUNIN_DOCKER_CONFIG=.

# SearXNG's settings directory is mounted READ-WRITE (the container rewrites
# it on boot), so it deliberately does NOT point at the tracked
# backend/docker/searxng or the container would dirty your working tree.
# Seed it once if you want our engine configuration rather than SearXNG's
# defaults:
#     mkdir -p .runtime/searxng && cp backend/docker/searxng/settings.yml .runtime/searxng/
# Skipping this is fine: web search prefers Brave anyway, and SearXNG is a
# best-effort supplement.
MUNIN_SEARXNG_CONFIG=../../.runtime/searxng


# ------------------------------------------------------------------------------
# The language model  (REQUIRED - nothing answers without this)
# ------------------------------------------------------------------------------
# Munin talks to any OpenAI-compatible /v1 endpoint. It does not host one for
# you by default. Point this at whatever you have:
#
#   Ollama          LLM_BASE_URL=http://host.docker.internal:11434
#                   LLM_MODEL_NAME=qwen3:32b
#   vLLM on host    LLM_BASE_URL=http://host.docker.internal:8000
#   Another machine LLM_BASE_URL=http://10.0.0.5:8000
#   The gpu profile LLM_BASE_URL=http://vllm:8000   (see below)
#
# The published results used Qwen3.6-35B-A3B-AWQ-4bit served by vLLM with tool
# calling and reasoning enabled. A smaller model will work but will do
# noticeably worse, especially on multi-step tool use. See docs/paper-kit/.
#
# (VLLM_URL / VLLM_MODEL_NAME are still accepted as aliases. The reference
# cluster sets those, so they cannot be dropped; new names win if both appear.)
LLM_BASE_URL=http://host.docker.internal:8000
LLM_MODEL_NAME=qwen3.6-35b-a3b

# Munin sends one non-OpenAI field: `chat_template_kwargs`, vLLM's passthrough
# to the chat template, used to switch OFF the model's reasoning trace for
# mechanical sub-tasks (summarise, expand a query, transcribe an equation).
# Strict servers reject unknown top-level fields with a 400.
#
# SET THIS TO 0 if summarise/expand calls fail while plain chat works. That is
# the signature. Cost of turning it off: those sub-tasks may emit reasoning
# that gets discarded, so they are slower and use more tokens. Nothing breaks.
LLM_THINKING_TOGGLE=1

# Context window the backend budgets against. Must not exceed what your
# endpoint actually serves, or turns fail late with a context error.
VLLM_MAX_MODEL_LEN=65536
VLLM_MAX_CONTEXT=60000


# ------------------------------------------------------------------------------
# Databases
# ------------------------------------------------------------------------------
# Change before exposing this host to anything.
NEO4J_PASSWORD=munin-neo4j-password
SEARXNG_SECRET=change-me-searxng-secret


# ------------------------------------------------------------------------------
# Resource sizing
# ------------------------------------------------------------------------------
# Defaults are sized for a cluster node with plenty of RAM. On a laptop, GROBID
# is the thing that will hurt: the default image carries deep-learning models
# and the default heap is 12 GB.
#
# Smaller GROBID (CRF only, a fraction of the image size, slightly worse
# reference parsing). Recommended for a demo machine:
#   GROBID_IMAGE=grobid/grobid:0.8.2
GROBID_IMAGE=lfoppiano/grobid:0.8.2
GROBID_JAVA_OPTS=-Xmx4g -Xms512m
GROBID_MEM_LIMIT=6G

# Parallel paper-ingest subprocesses. Keep below GROBID's engine pool.
INGEST_CONCURRENCY=2

# Log verbosity for the retrieval service.
LOG_LEVEL=INFO


# ------------------------------------------------------------------------------
# Optional: external APIs
# ------------------------------------------------------------------------------
# All optional. Without them, web search and some metadata lookups degrade but
# nothing breaks: the corpus and the citation graph still work.
#
# Brave is the primary web-search source (SearXNG's scrapers are blocked from
# most datacenter IPs). Free tier is 1 req/s.
BRAVE_API_KEY=
BRAVE_SEARCH_QPS=1
BRAVE_MAX_QUERIES=3

# Semantic Scholar raises the rate limit for external paper lookup.
SEMANTIC_SCHOLAR_API_KEY=

# Polite-pool identity for Unpaywall and Crossref. Set it to a real address
# you control; these APIs ask for one and throttle anonymous callers.
UNPAYWALL_EMAIL=you@example.org


# ------------------------------------------------------------------------------
# Optional: features that are off by default
# ------------------------------------------------------------------------------
# In-chat Deep Research. Long multi-step runs that share your LLM endpoint with
# interactive chat; 1 at a time is sensible on a single host.
DEEP_RESEARCH_MAX_CONCURRENT=1

# Hard cap on tool calls per answer. Lower it to make turns cheaper and faster;
# the measured effect of this cap is in docs/paper-kit/06-ABLATIONS.md.
CHAT_MAX_TOOL_CALLS=30


# ------------------------------------------------------------------------------
# Paper pipeline (profile: pipeline)
# ------------------------------------------------------------------------------
# Drop PDFs into $MUNIN_ROOT/data/papers/pdf/ and the watcher ingests them:
# GROBID parse -> Crossref enrich -> embed -> Qdrant + Neo4j.
#
# The encoder and the collection are a PAIR. Flip both or neither: a half-flip
# writes vectors the search path cannot read, and retrieval refuses to boot.
PAPER_ENCODER=bge-large
PAPERS_COLLECTION=papers_bge

# How often the watcher polls the drop directory.
WATCH_POLL_SECS=60

# Times of day for the two nightly jobs, local to the container.
REATTRIBUTE_AT=04:30
EMBEDDING_MAP_AT=01:30

# Build the embedding map once at startup instead of waiting for the first
# scheduled run. Worth leaving on for a fresh instance (the knowledge page is
# empty until the first build) and turning off once the corpus is stable.
EMBEDDING_MAP_ON_START=1

# Contact address recorded on papers this instance ingests.
PIPELINE_ADMIN_EMAIL=you@example.org


# ------------------------------------------------------------------------------
# Not yet wired up on a single host (tracked in docs/SINGLE-HOST-PLAN.md)
# ------------------------------------------------------------------------------
# The VPS half (Caddy, email-OTP auth, API gateway, uploads, chat UI) is not in
# COMPOSE_FILE above yet. Phase 4 of the plan adds it, along with:
#   - a local Caddyfile with no TLS and no public DNS names
#   - a build-time API base for the chat UI, which currently hardcodes the
#     production auth domain
#   - a dev OTP mode, since login today requires a working SMTP server
# Until then the backend API is reachable directly on 127.0.0.1:8080.
