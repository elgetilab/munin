[Unit]
Description=Nightly rebuild of the paper-embedding 2D map
Documentation=https://github.com/your-repo/munin-backend

[Timer]
# 01:30 every day, cluster-local time. Must complete before vLLM's
# 02:00 shutdown — typical runtime is ~5-6 min (UMAP ~1 min, HDBSCAN
# ~seconds, labelling ~4 min for ~220 clusters at ~1s/call). With the
# 5-min jitter below the worst-case start is 01:35, worst-case
# completion ~01:45 — still comfortably before 02:00.
#
# If we move back to a 24/7 vLLM schedule, push this back to 03:00.
OnCalendar=*-*-* 01:30:00
# If the cluster was off at 01:30, run on the next boot.
Persistent=true
# Spread across a few minutes so concurrent daily timers don't thunder.
RandomizedDelaySec=300
Unit=munin-embedding-map.service

[Install]
WantedBy=timers.target
