# ==============================================================================
# MUNIN FRONTEND (VPS) - Environment Variables
# ==============================================================================
# Copy this file to ~/munin/frontend/.env on the VPS and fill in the secrets.
# Docker compose reads it via `${VAR:-default}` interpolation in
# frontend/docker-compose.yml. The file MUST live next to docker-compose.yml
# (the post-monorepo path is ~/munin/frontend/.env, not the old ~/munin/.env).
# ==============================================================================

# ------------------------------------------------------------------------------
# Auth service (munin-auth)
# ------------------------------------------------------------------------------

# Itsdangerous signing key for session cookies. Generate with
# `openssl rand -hex 32`. Rotating invalidates all live sessions.
AUTH_SECRET_KEY=change-me-auth-secret-key

# SMTP transport for OTP delivery.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=noreply@example.org

# ------------------------------------------------------------------------------
# Admin allowlist (fallback for api-gateway)
# ------------------------------------------------------------------------------
# Comma-separated list of admin email addresses. The auth-DB role column
# is the canonical source after P1 #11; this env stays as a defence-in-depth
# fallback the gateway checks when the role header is absent.
ADMIN_EMAILS=admin@example.org

# ------------------------------------------------------------------------------
# Cluster ingest (VPS hook-service -> cluster /api/admin/ingest)
# ------------------------------------------------------------------------------
# Shared with the cluster side (set the same value in
# /opt/hugin/config/cluster.env). Generate with `openssl rand -hex 32`.
ADMIN_INGEST_TOKEN=change-me-admin-ingest-token

# ------------------------------------------------------------------------------
# P1 #11 - Knowledge-base contribution gate
# ------------------------------------------------------------------------------
# Bearer token the tusd hook-service presents to /admin/check-role on every
# pre-create. VPS-local only; the cluster does not need this. Generate fresh
# with `openssl rand -hex 32`.
KB_GATE_TOKEN=change-me-kb-gate-token

# If "true", upload pre-create allows the upload when /admin/check-role
# can't be reached. Default "false" rejects on error (fail-closed). Only
# flip this temporarily during an auth outage if KB writes must keep
# flowing.
KB_GATE_FAIL_OPEN=false

# ------------------------------------------------------------------------------
# P1 #11 - Contributors-yaml sync
# ------------------------------------------------------------------------------
# Bearer token the cluster's retrieval service uses to pull
# /admin/contributors.yaml from auth.muninai.org every 5 minutes. MUST
# match the value set in /opt/hugin/config/cluster.env on the cluster.
# Generate with `openssl rand -hex 32`.
CONTRIBUTORS_SYNC_TOKEN=change-me-contributors-sync-token
