# Qwen3.8-27B, the production backbone since 2026-08-26.
# Dense 27B, hybrid Gated DeltaNet + Gated Attention (16 of 64 layers hold KV),
# AWQ-INT4 g32 with DeltaNet projections, vision tower, lm_head and MTP at BF16.
MODEL_SLUG=qwen3.8-27b
MODEL_ID=cyankiwi/Qwen3.8-27B-AWQ-INT4
MODEL_DIR=qwen3.8-27b-awq-int4
MODEL_NAME=qwen3.8-27b
MODEL_DESC="Qwen3.8-27B (dense, Gated DeltaNet + Gated Attention, AWQ-INT4 g32, 64k ctx, vision)"
HF_EXCLUDE=
VLLM_QUANTIZATION=compressed-tensors
VLLM_KV_CACHE_DTYPE=fp8
VLLM_TOOL_PARSER=qwen3_xml
VLLM_REASONING_PARSER=qwen3
VLLM_EXTRA_ARGS=
VLLM_GPU_MEM_UTIL=0.90
VLLM_MAX_MODEL_LEN=65536
# 2 is the KV ceiling on one 32 GB card (206,802 tokens = 3.16x at 64k, measured
# 2026-08-25); do not raise it, see start-vllm-service.sh. TP=2 doubles the pool.
VLLM_MAX_NUM_SEQS_SINGLE=2
VLLM_MAX_NUM_SEQS_TP2=8
LLM_THINKING_MODE=enable_thinking
# medium, not the model's own xhigh: xhigh burned 11,374 completion tokens for
# a 672-character answer and returned EMPTY at an 8K cap (database.py).
LLM_REASONING_EFFORT=medium
KV_KIB_PER_TOKEN=32
# Qwen3's recommended sampling, byte-identical to what the personas carried
# until 2026-09-15 and to every committed benchmark run on this backbone.
SAMPLING_DEFAULT='{"temperature": 1.0, "top_p": 0.95, "top_k": 20, "min_p": 0.0, "presence_penalty": 1.5}'
SAMPLING_CODE='{"temperature": 0.6, "top_p": 0.95, "top_k": 20, "min_p": 0.0, "presence_penalty": 0.0}'
