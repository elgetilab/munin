[Unit]
Description=Munin paper-embedding 2D map + cluster rebuild (§15)
Documentation=https://github.com/your-repo/munin-backend
After=network.target docker.service
Wants=docker.service

[Service]
Type=oneshot
User=root
Group=root

ExecStart=/opt/munin/services/knowledge/venv/bin/python3 /opt/cluster/scripts/knowledge/build_embedding_map.py

Environment="QDRANT_HOST=127.0.0.1"
Environment="QDRANT_PORT=6333"
# The collection the map is built FROM. Must track the live PAPERS_COLLECTION;
# `papers` is the retired 768d SPECTER corpus. This said `papers` until
# 2026-08-14 and production was correct only because of an untracked systemd
# drop-in added at the 2026-07 cutover, so a deploy to a fresh cluster would
# have mapped the wrong corpus. Same "defaults must be production" rule as
# DECISIONS.md 2026-08.
Environment="QDRANT_COLLECTION=papers_bge"
Environment="VLLM_URL=http://127.0.0.1:8000"
# Backbone identity from the active model profile (deploy.sh model activate),
# so a model change never has to touch this unit: the profile's MODEL_NAME is
# what build_embedding_map.py asks vLLM for, and it falls back to its own
# default on a box without the file. Do not pin a model name here; a pinned
# qwen3.6-35b-a3b failed every nightly run after the 2026-08 backbone change.
Environment="LLM_THINKING_MODE=enable_thinking"
EnvironmentFile=-/opt/munin/config/active-model.env
Environment="EMBEDDING_MAP_PATH=/opt/munin/knowledge/embedding_map.json"
# Numba (UMAP's JIT) needs a writable cache dir. ProtectSystem=strict +
# ProtectHome=yes kill the default locations (site-packages, ~/.cache).
Environment="NUMBA_CACHE_DIR=/opt/munin/knowledge/numba-cache"

StandardOutput=journal
StandardError=journal
SyslogIdentifier=munin-embedding-map

NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/munin/knowledge
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
