# Vite build output: `webui` builds here (outDir + emptyOutDir, so the
# whole dir is regenerated by `npm run build`). Deploy rsyncs it from the
# working tree, not git, so it never needs to be committed. Sources live
# in frontend/webui/src + frontend/webui/public.
/frontend/static/chat/

