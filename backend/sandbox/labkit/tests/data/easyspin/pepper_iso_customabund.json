    "Sys.A = [50 400];",
    "Sys.Abund = [1 1];",
    "Sys.lwpp = 0.3;",
    "Exp.mwFreq = 9.5;",
    "Exp.Range = [280 350];",
    "Exp.nPoints = 1e4;",
    "Opt.GridSize = 61;",
    "Opt.Method = 'perturb';",
    "[x,y] = pepper(Sys,Exp,Opt);"
