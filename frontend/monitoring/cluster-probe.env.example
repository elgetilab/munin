# /etc/munin/cluster-probe.env (root:root 0600). Read by munin-cluster-probe.service.
# The same Discord webhook as MUNIN_ALERT_WEBHOOK in the cluster's cluster.env.
# The probe refuses to POST while this still says CHANGE-ME.
MUNIN_ALERT_WEBHOOK=https://discord.com/api/webhooks/CHANGE-ME
# MUNIN_ALERT_FORMAT=discord
# PROBE_URL=http://127.0.0.1:18080/api/status
# PROBE_DOWN_AFTER_S=600
