# .env for the lite install, from the repo root. See docs/install/lite.md.
COMPOSE_FILE=backend/docker/docker-compose.yml:backend/docker/lite.yml
COMPOSE_PROFILES=rag,llm-claude

# ---- the Claude API (these three go together)
ANTHROPIC_API_KEY=
LLM_BASE_URL=http://llm-claude:8000
LLM_MODEL_NAME=claude-haiku-5-5

# ---- reached by the gateway at its existing tunnel address, so the frontend
# needs no change. Loopback only: retrieval trusts the gateway's identity headers.
RETRIEVAL_HOST_PORT=18080

# ---- must match the frontend's .env
MUNIN_DOMAIN=
KB_GATE_TOKEN=
CONTRIBUTORS_SYNC_TOKEN=
MUNIN_GATEWAY_TOKEN=

# ---- not reachable from inside the container on this host
CONTRIBUTORS_SYNC_URL=
AUTH_CHECK_ROLE_URL=

# ---- compose requires these even for services that stay off
NEO4J_PASSWORD=unused
SEARXNG_SECRET=
# Web search prefers Brave; SearXNG is often blocked from datacenter addresses.
BRAVE_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_API_KEY=

# ---- paths, relative to backend/docker
MUNIN_ROOT=../../.runtime
MUNIN_RETRIEVAL_SRC=../retrieval
MUNIN_SANDBOX_SRC=../sandbox
MUNIN_LLM_CLAUDE_SRC=../llm-claude
MUNIN_PIPELINE_SRC=../scripts/pipeline
MUNIN_SCRIPTS_SRC=../scripts
MUNIN_KNOWLEDGE_SRC=../scripts/knowledge
MUNIN_PERSONAS_SRC=../../shared/personas
MUNIN_AGENT_CONFIG=../config
MUNIN_DOCKER_CONFIG=.
MUNIN_SEARXNG_CONFIG=../../.runtime/searxng
SANDBOX_CPUS=1
