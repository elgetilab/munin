{
 "id": "s1_nist_lanczos1",
 "suite": "S1",
 "inputs": [
  "lanczos1.csv"
 ],
 "turns": [
  {
   "prompt": "Fit the nonlinear model y = b1*exp(-b2*x) + b3*exp(-b4*x) + b5*exp(-b6*x) to the data in lanczos1.csv (columns x, y) by least squares, starting from b1 = 1.2, b2 = 0.3, b3 = 5.6, b4 = 5.5, b5 = 6.5, b6 = 7.6. Report every parameter (b1, b2, b3, b4, b5, b6) to at least 6 significant digits and the residual sum of squares as rss.",
   "checks": [
    {
     "type": "numeric",
     "key": "b1",
     "truth": "truth:certified.b1",
     "rtol": 0.0001
    },
    {
     "type": "numeric",
     "key": "b2",
     "truth": "truth:certified.b2",
     "rtol": 0.0001
    },
    {
     "type": "numeric",
     "key": "b3",
     "truth": "truth:certified.b3",
     "rtol": 0.0001
    },
    {
     "type": "numeric",
     "key": "b4",
     "truth": "truth:certified.b4",
     "rtol": 0.0001
    },
    {
     "type": "numeric",
     "key": "b5",
     "truth": "truth:certified.b5",
     "rtol": 0.0001
    },
    {
     "type": "numeric",
     "key": "b6",
     "truth": "truth:certified.b6",
     "rtol": 0.0001
    },
    {
     "type": "numeric",
     "key": "rss",
     "truth": "truth:rss",
     "rtol": 0.0001,
     "atol": 1e-15
    }
   ]
  }
 ],
 "results_keys": {
  "b1": "",
  "b2": "",
  "b3": "",
  "b4": "",
  "b5": "",
  "b6": "",
  "rss": ""
 },
 "tags": [
  "nist",
  "nist:average"
 ],
 "provenance": "NIST StRD Lanczos1 (public domain), data copied verbatim"
}
