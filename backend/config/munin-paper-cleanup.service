[Unit]
Description=Munin paper-cleanup — nightly metadata-unverifiable sweep
Documentation=scripts/pipeline/INGEST.md
After=network.target docker.service
Wants=docker.service

[Service]
Type=oneshot
User=root
Group=root

# Walks up to 200 papers per run via repair_and_clean's multi-source
# enrichment (OpenAlex / Semantic Scholar / CrossRef). Papers no
# source can confirm are auto-quarantined (capped at 20 per night so
# a bad-source day can't empty the corpus). No vLLM dependency →
# safe in any window including 02:00-06:00.
#
# Phase D of the 2026-05-13 consolidation: the verb changed from
# --auto-remove (destructive) to --auto-quarantine (soft). Records
# now move to /papers/pdf/quarantine/ with a state sidecar
# explaining why, instead of being deleted from Qdrant + Neo4j +
# disk. The operator confirms via `paper_cleanup.py review`
# (Phase E) before final rejection.
ExecStart=/opt/munin/services/pipeline/venv/bin/python3 \
    /opt/cluster/scripts/pipeline/paper_cleanup.py \
    detect \
    --kinds metadata-unverifiable \
    --max-check 200 \
    --auto-quarantine \
    --limit 20

Environment="QDRANT_HOST=127.0.0.1"
Environment="QDRANT_PORT=6333"
Environment="NEO4J_URI=bolt://127.0.0.1:7687"
Environment="NEO4J_USER=neo4j"
Environment="ADMIN_EMAIL=admin@muninai.org"
EnvironmentFile=-/opt/hugin/config/cluster.env

StandardOutput=journal
StandardError=journal
SyslogIdentifier=munin-paper-cleanup

NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/munin/data/papers
ProtectHome=yes
PrivateTmp=yes
