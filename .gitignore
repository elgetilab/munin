# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.coverage
htmlcov/

# --- Node / Vite (frontend/webui) ---
node_modules/
dist/
.vite/
*.log
npm-debug.log*

# Vite build output: `webui` builds here (outDir + emptyOutDir, so the
# whole dir is regenerated by `npm run build`). Deploy rsyncs it from the
# working tree, not git, so it never needs to be committed. Sources live
# in frontend/webui/src + frontend/webui/public.
/frontend/static/chat/

# --- IDE / editors ---
.idea/
.vscode/
*.swp

# --- OS ---
.DS_Store
Thumbs.db

# --- Secrets / local config ---
.env
.env.local
*.env
!*.env.template
!*.env.example
!secrets.env.example
# Backbone model profiles carry no secrets (checkpoint ids, parsers, sampling)
# and MUST be committed: deploy.sh model activate reads them from the repo.
!backend/config/models/*.env

# --- Local artifacts ---
*.local
# The single-host Caddyfile is source, not local state.
!/frontend/caddy/Caddyfile.local
*.bak

# Runtime state for a single-host `docker compose up` from a clone: vector DB,
# graph DB, chat SQLite, uploaded PDFs, downloaded model weights, caches. The
# reference cluster keeps the equivalent under /opt/munin. Location is set by
# MUNIN_ROOT in the repo-root .env; see .env.example.
/.runtime/
/backend/.claude/scheduled_tasks.lock
/backend/.claude/
/backend/.claude/

# Claude Code assistant context. Kept on disk for local sessions, out of the
# public repo (removed from tracking 2026-08-04). The project-facing content
# they duplicated lives in README.md / DESIGN.md / shared/docs/.
CLAUDE.md
**/CLAUDE.md
.claude/
**/.claude/

# Real people: seed and quota files that stay on the hosts. Commit the .example files.
/frontend/auth/whitelist.csv
/shared/config/contributors.yml
# Per-record corpus audit outputs (paper ids, uploader records). Only the
# aggregate summaries in backend/docs/corpus-quality/ are committed.
/backend/docs/corpus-quality/*.csv
/backend/docs/corpus-quality/*.txt
/backend/docs/corpus-quality/*-AUDIT-*.json
/backend/docs/corpus-quality/*-REPAIR-*.json
/backend/docs/corpus-quality/R2-*.json
/backend/docs/corpus-quality/DOI-SPOTCHECK-????-??-??.md
/frontend/config/quotas.yml
