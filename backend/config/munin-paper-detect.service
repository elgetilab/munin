[Unit]
Description=Munin paper-detect — continuous detection sweep
Documentation=scripts/pipeline/INGEST.md
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=root
Group=root

# Continuous loop wrapper around `paper_cleanup.py detect`. Walks
# the corpus in small paced batches and auto-quarantines bad
# records without operator action. Replaced the nightly
# munin-paper-cleanup.timer (which fired one big batch at 04:00).
#
# Phase F of the 2026-05-13 consolidation. Tunables live in the
# Environment= block below — the operator can adjust cadence /
# batch size without touching code, then `systemctl restart
# munin-paper-detect`.
# Detection only (--no-quarantine) since 2026-10-04. Auto-quarantine deletes
# a paper's Qdrant point, and the metadata-unverifiable check flags exactly the
# papers the old doi_*.pdf decoder keyed to nonexistent DOIs, which the pending
# DOI repair (repair_doi_filenames.py) needs in place to re-key. Drop the flag
# once that repair has been applied.
ExecStart=/opt/munin/services/pipeline/venv/bin/python3 \
    /opt/cluster/scripts/pipeline/paper_cleanup.py sweep --no-quarantine

# Connection targets (containers exposed on 127.0.0.1).
Environment="QDRANT_HOST=127.0.0.1"
Environment="QDRANT_PORT=6333"
Environment="NEO4J_URI=bolt://127.0.0.1:7687"
Environment="NEO4J_USER=neo4j"
Environment="GROBID_URL=http://127.0.0.1:8070"
# ADMIN_EMAIL (Crossref polite-pool contact) comes from cluster.env below,
# falling back to MUNIN_CONTACT_EMAIL.

# Sweep tunables. Defaults: 4 detection kinds, 5 records/kind/cycle,
# 15-min cycles, 30s GROBID pacing.
Environment="DETECT_KINDS=metadata-mismatch,short,orphan,metadata-unverifiable"
Environment="DETECT_PER_CYCLE_LIMIT=5"
Environment="DETECT_CYCLE_PACE_SECS=900"
Environment="DETECT_GROBID_PACE_SECS=30"

# NEO4J_PASSWORD + SEMANTIC_SCHOLAR_API_KEY live in cluster.env.
EnvironmentFile=-/opt/hugin/config/cluster.env

StandardOutput=journal
StandardError=journal
SyslogIdentifier=munin-paper-detect

# Restart on crash with a back-off long enough to survive transient
# Qdrant/GROBID flaps without spinning. SIGINT exits cleanly (the
# sweep loop catches KeyboardInterrupt and returns 0).
Restart=on-failure
RestartSec=60
TimeoutStopSec=30

NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/munin/data/papers
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
