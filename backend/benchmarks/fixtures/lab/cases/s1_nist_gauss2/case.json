{
 "id": "s1_nist_gauss2",
 "suite": "S1",
 "inputs": [
  "gauss2.csv"
 ],
 "turns": [
  {
   "prompt": "Fit the nonlinear model y = b1*exp( -b2*x ) + b3*exp( -(x-b4)**2 / b5**2 ) + b6*exp( -(x-b7)**2 / b8**2 ) to the data in gauss2.csv (columns x, y) by least squares, starting from b1 = 96.0, b2 = 0.009, b3 = 103.0, b4 = 106.0, b5 = 18.0, b6 = 72.0, b7 = 151.0, b8 = 18.0. Report every parameter (b1, b2, b3, b4, b5, b6, b7, b8) to at least 6 significant digits and the residual sum of squares as rss.",
   "checks": [
    {
     "type": "numeric",
     "key": "b1",
     "truth": "truth:certified.b1",
     "rtol": 0.0001
    },
    {
     "type": "numeric",
     "key": "b2",
     "truth": "truth:certified.b2",
     "rtol": 0.0001
    },
    {
     "type": "numeric",
     "key": "b3",
     "truth": "truth:certified.b3",
     "rtol": 0.0001
    },
    {
     "type": "numeric",
     "key": "b4",
     "truth": "truth:certified.b4",
     "rtol": 0.0001
    },
    {
     "type": "numeric",
     "key": "b5",
     "truth": "truth:certified.b5",
     "rtol": 0.0001
    },
    {
     "type": "numeric",
     "key": "b6",
     "truth": "truth:certified.b6",
     "rtol": 0.0001
    },
    {
     "type": "numeric",
     "key": "b7",
     "truth": "truth:certified.b7",
     "rtol": 0.0001
    },
    {
     "type": "numeric",
     "key": "b8",
     "truth": "truth:certified.b8",
     "rtol": 0.0001
    },
    {
     "type": "numeric",
     "key": "rss",
     "truth": "truth:rss",
     "rtol": 0.0001,
     "atol": 0
    }
   ]
  }
 ],
 "results_keys": {
