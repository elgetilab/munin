# ==============================================================================
# MUNIN CHAT UI - build-time configuration
# ==============================================================================
# Vite inlines `import.meta.env.VITE_*` at BUILD time, so these are compiled
# into the bundle. Changing one requires a rebuild, not a restart.
#
# You do not need this file for a deployment that follows the subdomain
# layout: with no VITE_* set, src/lib/urls.ts derives every URL at runtime from
# the host the UI is served on (chat.<domain> -> auth.<domain>, ...), so one
# `npm run build` works on any domain.
#
# For a single-host run, docker compose passes these as build args instead
# (see the webui-build service); this file is for building by hand:
#
#     cp .env.example .env.local && npm run build
# ==============================================================================

# Auth service origin. THE ONLY FUNCTIONAL ONE: /auth/me and the admin API are
# fetched from it, so a wrong value breaks login and the admin panel while the
# rest of the app appears to work.
#
# For the single-host setup, auth is served from the same origin as the chat UI
# (see caddy/Caddyfile.local), which also means the session cookie needs no
# cross-site handling:
VITE_AUTH_BASE=http://localhost

# Navigation links to the sibling sites. Wrong values here are dead links in
# the header, not a broken app. The local Caddyfile puts these on ports.
VITE_SITE_HOME=http://localhost:8083
VITE_CHAT_URL=http://localhost
VITE_SEARCH_URL=http://localhost:8081
VITE_DOCS_URL=http://localhost:8082
VITE_UPLOAD_URL=http://localhost

# Shown in Settings as the base_url for API-key clients. Display only.
VITE_API_PUBLIC_URL=http://localhost/api/v1
