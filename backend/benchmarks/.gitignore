# Python
__pycache__/
*.pyc
.pytest_cache/

# Benchmark data + raw outputs are NOT committed (size + licenses); the
# loaders fetch the datasets (ir_datasets, Hugging Face). Committed instead:
# scorecards/ (small JSONs), verdicts/ (per-question verdict tables, qids only),
# and the abstention ground-truth JSON. The LitQA2 frozen variant set stays
# in data/ because it is keyed by LitQA2 question text.
data/
results/
# Track B live-capture artifacts (answers + retrieved contexts). Bulky
# (~2MB/arm) and regenerable from the live chat; the derived scorecard under
# scorecards/ is the committed record.
faithfulness_runs/
c1_runs/
c2_runs/
ablation_runs/
# run_suite.sh driver state (phase markers, logs, gate copies); per run, not regenerable, not committed
runs/
