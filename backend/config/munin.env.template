# ==============================================================================
# MUNIN BACKEND - Environment Variables
# ==============================================================================
# The reference deployment keeps this at /opt/hugin/config/cluster.env
# (deploy.sh's HUGIN_ENV), linked to /opt/munin/docker/.env so compose reads it
# through `${VAR:-default}` interpolation. Container-internal paths and service
# addresses (Qdrant, GROBID, SearXNG, model mounts) are fixed in
# docker-compose.yml and are deliberately not set here.
# ==============================================================================

# ------------------------------------------------------------------------------
# Where this instance lives  (REQUIRED; deploy.sh refuses to run without them)
# ------------------------------------------------------------------------------
# Base domain of the gateway. Paper links (search.<domain>), the auth service
# the cluster calls back to (auth.<domain>) and the cookie domain all derive
# from it. There is deliberately no default.
MUNIN_DOMAIN=lab.example.edu
# How the system prompt names your cluster: "You are Munin, an AI assistant on
# <MUNIN_CLUSTER_NAME>."
# Quote it: bash sources this file too, and an unquoted space breaks that.
MUNIN_CLUSTER_NAME="the Example Lab research cluster"
# Contact address Crossref, NCBI and Unpaywall ask API clients for. A real
# mailbox you read; left out of requests when empty.
MUNIN_CONTACT_EMAIL=
# The VPS the reverse tunnel dials (deploy.sh tunnel aborts without it).
MUNIN_VPS_HOST=vps.lab.example.edu
# Shared secret with the frontend. MUST match MUNIN_GATEWAY_TOKEN in the VPS
# .env. With it set, retrieval refuses forwarded identity headers that lack it;
# cluster-side scripts that call retrieval directly must then send it as
# X-Munin-Gateway-Token. Empty on both sides: not checked.
MUNIN_GATEWAY_TOKEN=

# ------------------------------------------------------------------------------
# Databases
# ------------------------------------------------------------------------------
QDRANT_HOST=qdrant

NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-neo4j-password

# ------------------------------------------------------------------------------
# Search + PDF parsing
# ------------------------------------------------------------------------------
# Required: openssl rand -hex 32
SEARXNG_SECRET=change-me-searxng-secret


# ------------------------------------------------------------------------------
# Paper corpus + APIs
# ------------------------------------------------------------------------------
SEMANTIC_SCHOLAR_API_KEY=

# ------------------------------------------------------------------------------
# vLLM (runs on host, GPU 1, via SLURM)
# ------------------------------------------------------------------------------
# When retrieval runs inside docker, reach host via host.docker.internal
VLLM_URL=http://host.docker.internal:8000
# The model name, parsers, thinking mode and sampling profile come from the
# ACTIVE model profile (/opt/munin/config/active-model.env, written by
# `deploy.sh model activate <slug>` from backend/config/models/<slug>.env) and
# are exported into compose by the vLLM start scripts and deploy.sh. Do not
# set VLLM_MODEL_NAME here; edit or add a profile instead.

# A3 (persona -> router migration): up-front per-turn router. true = each turn's
# profile (chat|research|code) is chosen from the query (biased by the pin);
# the system prompt is composed base[pin] + fragment[routed], sampling + tools
# from the routed profile. true is the default and what the published numbers
# used; false pins every turn to its persona's own profile.
ROUTER_ENABLED=true

# Context budgeting for chat compaction.
# VLLM_MAX_MODEL_LEN / VLLM_MAX_CONTEXT are pinned by the vLLM start scripts to
# match the running mode (single-GPU: 65536/60000; TP=2: 131072/125000), so the
# retrieval service uses the right window. The values below are the single-GPU
# defaults applied on a fresh bootstrap.
VLLM_MAX_MODEL_LEN=65536
VLLM_MAX_CONTEXT=60000
# Must equal the output cap (VLLM_MAX_OUTPUT_TOKENS / DEFAULT_MAX_OUTPUT_TOKENS,
# 16384) so the history trim reserves the real generation budget (Tier-3). Was
# 8000, which under-reserved and silently overrode the code default.
VLLM_GENERATION_RESERVE=16384

# ------------------------------------------------------------------------------
# Paper encoder (encoder migration; todo_v2/ENCODER-MIGRATION-PLAN.md)
# ------------------------------------------------------------------------------
# BGE-large into the 1024d `papers_bge` collection is what runs in production
# and what the published numbers used. The encoder and the collection are a
# PAIR: change both or neither (retrieval refuses to boot on a half-flip).
# SPECTER-v1 + `papers` is kept only as a rollback.
PAPER_ENCODER=bge-large
PAPERS_COLLECTION=papers_bge
BGE_LARGE_MODEL_PATH=/models/bge-large

# ------------------------------------------------------------------------------
# Personas + agents
# ------------------------------------------------------------------------------
PERSONAS_DIR=/app/personas
AGENTS_CONFIG=/app/config/agents.yml

# ------------------------------------------------------------------------------
# §28 Contributor ingest (upload.<domain> → VPS hook → /api/admin/ingest)
# ------------------------------------------------------------------------------
# Shared secret between VPS hook_service and the cluster retrieval API.
# Generate a fresh value with `openssl rand -hex 32` and set the SAME
# value on the VPS side so hook_service can authenticate.
ADMIN_INGEST_TOKEN=change-me-admin-ingest-token

# Where retrieval reads + writes contributors.yml. Points at /data
# (writable) inside the container; /app/config is read-only so the
# 5-minute contributors_sync.py timer needs a writable path. The
# deploy bootstrap puts an initial copy at /opt/munin/data/contributors.yml
# (= /data inside) so ingest works before the first sync lands.

# ------------------------------------------------------------------------------
# P1 #11 - Contributors sync from auth service
# ------------------------------------------------------------------------------
# Bearer token retrieval uses to pull /admin/contributors.yaml from the
# VPS auth service. MUST match the value set in frontend/.env on the
# VPS (CONTRIBUTORS_SYNC_TOKEN). Generate with `openssl rand -hex 32`.
CONTRIBUTORS_SYNC_TOKEN=change-me-contributors-sync-token

# Override the sync URL if your auth service lives elsewhere. Default
# (set in docker-compose.yml) is https://auth.<MUNIN_DOMAIN>/admin/contributors.yaml.
# CONTRIBUTORS_SYNC_URL=https://auth.your-domain.tld/admin/contributors.yaml

# Override the poll interval if 5 minutes feels too long or too short.
# Lower bound is implicitly the failure-backoff window (60s).
# CONTRIBUTORS_SYNC_INTERVAL_SECS=300

# ------------------------------------------------------------------------------
# Monitoring - admin metrics proxy (in-house Grafana replacement)
# ------------------------------------------------------------------------------
# Bearer token retrieval uses to call /admin/check-role on the VPS
# auth service for the admin-only metrics dashboard. MUST match the
# value set in frontend/.env on the VPS (KB_GATE_TOKEN). Generate
# with `openssl rand -hex 32` -- the same token is used by the tusd
# pre-create hook on the VPS, so if you've already set one for KB
# uploads, reuse that exact value here.
#
# SHARED SECRET with no auto-sync: the live value lives in
# /opt/hugin/config/cluster.env (deploy.sh symlinks the compose .env
# to it). Edit cluster.env IN PLACE -- never replace the
# /opt/munin/docker/.env symlink with a copy, or the next deploy
# restores the symlink and silently reverts your change. If this and
# the VPS value drift, the admin Metrics tab breaks (proxy 502 /
# check-role 401). See shared/docs/MONITORING.md.
KB_GATE_TOKEN=change-me-kb-gate-token

# Override if your auth service lives elsewhere. Default (set in
# docker-compose.yml) is https://auth.<MUNIN_DOMAIN>/admin/check-role.
# AUTH_CHECK_ROLE_URL=https://auth.your-domain.tld/admin/check-role

# Override only if you've moved Prometheus off the default docker
# service name. Default is http://prometheus:9090 which works as
# long as you ran `sudo ./deploy.sh monitoring`.
# PROMETHEUS_URL=http://prometheus:9090

# Optional: let `deploy.sh verify` cross-check that KB_GATE_TOKEN above
# matches the VPS copy (frontend/.env). Set METRICS_VPS_SSH to an ssh
# target that can `docker exec` the auth container on the VPS; the check
# compares fingerprints and WARNS on drift (never fails the deploy).
# Unset = the cross-host check is skipped. METRICS_VPS_SSH_KEY is the
# optional identity file (needed when deploy runs as root via sudo, since
# root's ~/.ssh won't hold the admin key).
# METRICS_VPS_SSH=admin@vps-host
# METRICS_VPS_SSH_KEY=/home/you/.ssh/munin_admin
