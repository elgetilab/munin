{
 "id": "s1_nist_thurber",
 "suite": "S1",
 "inputs": [
  "thurber.csv"
 ],
 "turns": [
  {
   "prompt": "Fit the nonlinear model y = (b1 + b2*x + b3*x**2 + b4*x**3) / (1 + b5*x + b6*x**2 + b7*x**3) to the data in thurber.csv (columns x, y) by least squares, starting from b1 = 1000, b2 = 1000, b3 = 400, b4 = 40, b5 = 0.7, b6 = 0.3, b7 = 0.03. Report every parameter (b1, b2, b3, b4, b5, b6, b7) to at least 6 significant digits and the residual sum of squares as rss.",
   "checks": [
    {
     "type": "numeric",
     "key": "b1",
     "truth": "truth:certified.b1",
     "rtol": 0.0001
    },
    {
     "type": "numeric",
     "key": "b2",
     "truth": "truth:certified.b2",
     "rtol": 0.0001
    },
    {
     "type": "numeric",
     "key": "b3",
     "truth": "truth:certified.b3",
     "rtol": 0.0001
    },
    {
     "type": "numeric",
     "key": "b4",
     "truth": "truth:certified.b4",
     "rtol": 0.0001
    },
    {
     "type": "numeric",
     "key": "b5",
     "truth": "truth:certified.b5",
     "rtol": 0.0001
    },
    {
     "type": "numeric",
     "key": "b6",
     "truth": "truth:certified.b6",
     "rtol": 0.0001
    },
    {
     "type": "numeric",
     "key": "b7",
     "truth": "truth:certified.b7",
     "rtol": 0.0001
    },
    {
     "type": "numeric",
     "key": "rss",
     "truth": "truth:rss",
     "rtol": 0.0001,
     "atol": 0
    }
   ]
  }
 ],
 "results_keys": {
  "b1": "",
  "b2": "",
  "b3": "",
  "b4": "",
  "b5": "",
  "b6": "",
  "b7": "",
  "rss": ""
 },
