# gpt-oss-20b, the cross-lab backbone (THIRD-MODEL-REVIEW Experiment A).
# MoE 21B total / 3.6B active, 24 layers alternating full and 128-token sliding
# attention, 8 KV heads x head_dim 64, native MXFP4 on the experts (attention,
# router, embeddings and lm_head stay BF16), 131k native context, text only.
# Reasoning is always on (harmony format); the effort dial is the only control.
MODEL_SLUG=gpt-oss-20b
MODEL_ID=openai/gpt-oss-20b
MODEL_DIR=gpt-oss-20b
MODEL_NAME=gpt-oss-20b
MODEL_DESC="gpt-oss-20b (MoE 21B / 3.6B active, native MXFP4, 64k ctx, text only)"
# The repo also ships original/ (a second 12.8 GiB copy) and metal/ (Apple).
HF_EXCLUDE="original/* metal/*"
# Blank: vLLM reads quant_method=mxfp4 from config.json. On SM120 (RTX 5090)
# the MoE oracle lands on the Marlin kernel; the start log's
# "Mxfp4 MoE backend" line is stamped into every scorecard.
VLLM_QUANTIZATION=
VLLM_KV_CACHE_DTYPE=fp8
VLLM_TOOL_PARSER=openai
VLLM_REASONING_PARSER=openai_gptoss
VLLM_EXTRA_ARGS=
VLLM_GPU_MEM_UTIL=0.90
VLLM_MAX_MODEL_LEN=65536
# 12 KiB/token leaves ~1.1M KV tokens on one 32 GB card (~17x at 64k), so the
# cap could be far higher; held at 2 so the measured configuration matches
# the other backbones' profile. Raise freely for actual use.
VLLM_MAX_NUM_SEQS_SINGLE=2
VLLM_MAX_NUM_SEQS_TP2=8
# enable_thinking is ignored by the harmony template; sub-tasks get
# reasoning_effort=low instead (a short trace rather than none: report it).
LLM_THINKING_MODE=effort_low
LLM_REASONING_EFFORT=medium
KV_KIB_PER_TOKEN=12
# OpenAI's recommendation for gpt-oss: temperature 1.0, top_p 1.0, nothing else.
SAMPLING_DEFAULT='{"temperature": 1.0, "top_p": 1.0}'
SAMPLING_CODE='{"temperature": 1.0, "top_p": 1.0}'
