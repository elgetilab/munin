[Unit]
Description=Munin paper-pipeline watcher — continuously ingest PDFs dropped into /opt/munin/data/papers/pdf/
Documentation=docs/PAPER-PIPELINE-AUTOMATION.md
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=root
Group=root

# --watch polls /opt/munin/data/papers/pdf/*.pdf every WATCH_POLL_SECS
# (default 60 s). Any PDF without a corresponding marker in
# /opt/munin/data/papers/processed/ gets pushed through the full
# GROBID → CrossRef → SPECTER → Qdrant + Neo4j pipeline. --fast
# batches embeddings; --workers parallelises GROBID calls.
ExecStart=/opt/munin/services/pipeline/venv/bin/python3 \
    /opt/cluster/scripts/pipeline/paper_pipeline.py \
    --watch --fast --workers 4 \
    --dir /opt/munin/data/papers/pdf

# Connection targets — containers are published on 127.0.0.1 so the
# host-side daemon reaches them the same way an external admin
# running the script manually would.
Environment="QDRANT_HOST=127.0.0.1"
Environment="QDRANT_PORT=6333"
Environment="NEO4J_URI=bolt://127.0.0.1:7687"
Environment="NEO4J_USER=neo4j"
Environment="GROBID_URL=http://127.0.0.1:8070"
Environment="ADMIN_EMAIL=admin@muninai.org"
# Poll interval for the --watch loop. 60s is the default; drop to
# 10s if a user is actively uploading batches and wants faster
# turnaround, raise to 300s on an idle corpus to save CPU cycles.
Environment="WATCH_POLL_SECS=60"
# NEO4J_PASSWORD + SEMANTIC_SCHOLAR_API_KEY live in cluster.env.
EnvironmentFile=-/opt/hugin/config/cluster.env

StandardOutput=journal
StandardError=journal
SyslogIdentifier=munin-paper-pipeline

# The watcher is a poll-loop; if it dies, restart after a small
# back-off. Don't restart on clean exit (Ctrl+C during maintenance).
Restart=on-failure
RestartSec=30
# Allow the process some headroom before systemd considers it failed.
# GROBID batches can take >1 min on a big PDF.
TimeoutStopSec=120

# Sandboxing — the daemon needs to read PDFs and write markers +
# marker JSONs, and needs an HTTP client to hit localhost services.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/munin/data/papers
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
