# Every site address is {$MUNIN_DOMAIN} (or a subdomain of it), substituted
# from the environment when Caddy parses this file; compose refuses to start
# without it. ACME_EMAIL defaults to info@<domain> (see docker-compose.yml).

# ── Global Options ────────────────────────────────────────────────────────────
{
	email {$ACME_EMAIL}
}

# ── Shared Snippets ──────────────────────────────────────────────────────────
(auth) {
	forward_auth 127.0.0.1:8090 {
		uri /auth/check
		copy_headers X-Munin-Email X-Munin-Name X-Munin-Role X-Munin-Group

		@unauthorized status 401
		handle_response @unauthorized {
			redir https://auth.{$MUNIN_DOMAIN}/login?redirect=https://{http.request.host}{http.request.uri} 302
		}
	}
}

# The static pages link to each other through {{env "MUNIN_URL_*"}} (set in
# docker-compose.yml), filled in by `templates` as they are served. HTML and
# JS only; never the chat SPA's built bundle, which is not a template.
(static-templates) {
	templates {
		mime text/html text/javascript application/javascript
	}
}

(shared-assets) {
	handle_path /shared/* {
		root * /srv/static/shared
		import static-templates
		file_server
	}
}

# ── Landing Page (public, NO auth) ──────────────────────────────────────────
{$MUNIN_DOMAIN} {
	import shared-assets
	root * /srv/static/landing
	import static-templates
	file_server
}

# ── Auth Portal (munin-auth login UI) ───────────────────────────────────────
auth.{$MUNIN_DOMAIN} {
	import shared-assets
	reverse_proxy 127.0.0.1:8090
}

# ── API Endpoint (CLI tools, Bearer token auth, no browser forward-auth) ────
# No forward_auth here, so nothing overwrites client-sent identity headers:
# strip them, or a request carrying X-Munin-Email is taken at its word by the
# gateway. The browser sites need no strip, since copy_headers already
# replaces them, and request_header must not go into the (auth) snippet:
# Caddy orders it after forward_auth, so it would delete the headers
# forward_auth just copied in.
api.{$MUNIN_DOMAIN} {
	request_header -X-Munin-Email
	request_header -X-Munin-Name
	request_header -X-Munin-Role
	request_header -X-Munin-Group
	reverse_proxy 127.0.0.1:8070
}

# ── Documentation ────────────────────────────────────────────────────────────
docs.{$MUNIN_DOMAIN} {
	import shared-assets
	import auth
	root * /srv/static/docs
	import static-templates
	file_server
}

# ── Chat (custom web UI) ────────────────────────────────────────────────────
chat.{$MUNIN_DOMAIN} {
	import shared-assets
	import auth
	handle /api/* {
		reverse_proxy 127.0.0.1:8070
	}
	handle /paper/* {
		reverse_proxy 127.0.0.1:18080
	}
	# Static maintenance page. Reachable at chat.<domain>/maintenance;
	# it fetches /api/status (same origin) and renders the operator's
	# maintenance message — the same flag the React app reads. Kept as a
	# plain static page so it works even if the chat SPA build is stale.
	handle /maintenance* {
		root * /srv/static/maintenance
		try_files {path} /index.html
		import static-templates
		file_server
	}
	handle {
		root * /srv/static/chat
		try_files {path} /index.html
		file_server
	}
}

# ── Paper Search ─────────────────────────────────────────────────────────────
search.{$MUNIN_DOMAIN} {
	import shared-assets
	import auth
	handle /api/* {
		reverse_proxy 127.0.0.1:8070
	}
	handle /paper/* {
		reverse_proxy 127.0.0.1:18080
	}
	handle {
		root * /srv/static/search
		import static-templates
		file_server
	}
}

# ── Deep Research ────────────────────────────────────────────────────────────
research.{$MUNIN_DOMAIN} {
	import shared-assets
	import auth
	handle /api/* {
		reverse_proxy 127.0.0.1:8070
	}
	handle {
		root * /srv/static/research
		import static-templates
		file_server
	}
}

# ── Paper Upload ─────────────────────────────────────────────────────────────
upload.{$MUNIN_DOMAIN} {
	import shared-assets
	import auth
	handle /whoami {
		header Content-Type application/json
		# Identity must never be served stale from the browser cache, or a
		# role/group change (and older role-less responses) would persist.
		header Cache-Control "no-store"
		respond `{"email":"{http.request.header.X-Munin-Email}","role":"{http.request.header.X-Munin-Role}","group":"{http.request.header.X-Munin-Group}"}` 200
	}
	handle /files/* {
		reverse_proxy 127.0.0.1:11080
	}
	handle {
		root * /srv/static/upload
		import static-templates
		file_server
	}
}
